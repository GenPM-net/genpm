# Copia este archivo a `.env.example` del proyecto (y tus valores reales a `.env.local`, nunca al repositorio).
# Base de datos (Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/site
# Sesiones y login (al menos un proveedor OAuth)
AUTH_SECRET=                     # ≥ 32 caracteres aleatorios
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# URL pública del sitio (https en producción). SEO_NOINDEX=1 en staging.
SITE_URL=http://localhost:3000
# SEO_NOINDEX=1
# Vista previa de borradores y antispam
CONTENT_PREVIEW_SECRET=          # ≥ 32 caracteres
ANTISPAM_SECRET=                 # ≥ 32 caracteres
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Cron de @core/jobs (Authorization: Bearer $CRON_SECRET)
CRON_SECRET=                     # ≥ 32 caracteres
# Archivos: S3/R2/MinIO…
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
# …o en local: STORAGE_DRIVER=local, STORAGE_SECRET (≥ 32), STORAGE_PUBLIC_URL=http://localhost:3000
# y la ruta app/api/storage/[[...key]]/route.ts (ver src/lib/storage/AGENTS.md).
# Email (Resend). Sin RESEND_API_KEY, fuera de producción, los correos se imprimen en consola.
EMAIL_FROM="Site <hello@example.com>"
RESEND_API_KEY=
# APP_NAME=Site                  # nombre en la plantilla de los correos
# Formularios: destinatario de los avisos
FORMS_NOTIFY_TO=
