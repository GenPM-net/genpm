# Environment for a site with @core/kit-cms. Copy to the project's `.env.example` (and add `!.env.example` to
# .gitignore); put real values in `.env.local`, never in the repository. Secrets: at least 32 random characters
# (e.g. `openssl rand -base64 32`).

# Database (any Postgres)
DATABASE_URL=postgres://user:password@localhost:5432/site

# Sign-in (@core/auth): at least one OAuth provider
AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Public URL (https in production). SEO_NOINDEX=1 on staging (noindex everywhere).
SITE_URL=http://localhost:3000
# SEO_NOINDEX=1
# Extra hosts allowed as absolute redirect targets, comma-separated (@core/site)
# SITE_REDIRECT_HOSTS=

# Content (@core/content): signed draft previews; default locale of entries
CONTENT_PREVIEW_SECRET=
# CONTENT_DEFAULT_LOCALE=en

# Forms and spam protection (@core/forms, @core/antispam)
ANTISPAM_SECRET=
FORMS_NOTIFY_TO=
# FORMS_WEBHOOK_SECRET=
# Optional captcha: Turnstile or hCaptcha
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# HCAPTCHA_SECRET_KEY=
# Client IP for rate limits: header set by your proxy/CDN, or X-Forwarded-For minus N trusted proxies
# ANTISPAM_IP_HEADER=cf-connecting-ip
# ANTISPAM_TRUSTED_PROXIES=1

# Background jobs (@core/jobs): GET /api/cron with Authorization: Bearer $CRON_SECRET every minute
CRON_SECRET=

# Files (@core/storage, @core/media): S3, R2 or MinIO…
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
# …or local disk for development (mount app/api/storage/[[...key]]/route.ts, see src/lib/storage/AGENTS.md):
# STORAGE_DRIVER=local
# STORAGE_SECRET=
# STORAGE_PUBLIC_URL=http://localhost:3000
# STORAGE_LOCAL_DIR=.storage   (add it to .gitignore)
# Image resizing by your CDN (see src/lib/media/AGENTS.md)
# MEDIA_TRANSFORM=

# Email (@core/email). Without RESEND_API_KEY, under `next dev`, emails are printed to the console.
EMAIL_FROM="Site <hello@example.com>"
RESEND_API_KEY=
# APP_NAME=Site
# SMTP instead of Resend: EMAIL_PROVIDER=smtp, SMTP_URL=smtps://user:pass@host:465 (install nodemailer)
