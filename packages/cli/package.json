{
  "name": "@genpm-net/cli",
  "version": "0.2.1",
  "description": "Install architectures, not dependencies: inject code + AI rules + MCP config from immutable Git commits",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "genpm": "dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "genpm",
    "mcp",
    "ai",
    "agents",
    "package-manager",
    "code-generation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/genpm-net/genpm.git",
    "directory": "packages/cli"
  },
  "homepage": "https://genpm.net",
  "scripts": {
    "build": "tsdown --config-loader native",
    "build:bin": "node scripts/build-binaries.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "cold-start": "node scripts/cold-start.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.0",
    "@genpm/core": "workspace:*",
    "@genpm/i18n": "workspace:*",
    "@genpm/manifest": "workspace:*",
    "@genpm-net/mcp": "workspace:*",
    "@genpm/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "citty": "^0.2.0",
    "picocolors": "^1.1.0",
    "tsdown": "^0.23.0"
  }
}
