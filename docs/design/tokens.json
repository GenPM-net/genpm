{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "GenPM design tokens v0.2 — identidad 'Anclado'. Fuente única para web (preset Tailwind + CSS vars), badges, OG images y CLI. Ver docs/branding.md §8.",
  "color": {
    "$type": "color",
    "paper":    { "$value": "#FFFFFF", "$description": "Fondo único" },
    "wash":     { "$value": "#F6F7F9", "$description": "Bloques de código, hover, nivel 2" },
    "line":     { "$value": "#E6E8EC", "$description": "Borde nivel 1" },
    "line-2":   { "$value": "#CDD2D9", "$description": "Borde nivel 2 (controles)" },
    "ink":      { "$value": "#0B0D11", "$description": "Marca, texto, CTA primario — 19.4:1" },
    "ink-2":    { "$value": "#4A505C", "$description": "Texto secundario — 8.2:1" },
    "ink-3":    { "$value": "#6A7180", "$description": "Metadatos, etiquetas — 4.9:1" },
    "code":     { "$value": "#549800", "$description": "Capa Code: señal gráfica (caret, nodos). Nunca texto. ≥ 3:1 también sobre wash" },
    "code-ink": { "$value": "#3B7300", "$description": "Capa Code: texto sobre blanco — 5.6:1; también success" },
    "context":  { "$value": "#5B4BDB", "$description": "Capa Context — 5.6:1" },
    "mcp":      { "$value": "#087584", "$description": "Capa Connections — ≥ 4.5:1 sobre paper y wash" },
    "warning":  { "$value": "#A15F00", "$description": "Drift, deprecated, Sponsored" },
    "danger":   { "$value": "#C62828", "$description": "Errores, flagged, yanked" },
    "dark": {
      "$description": "Superficies oscuras: terminal, IDE, avatar y modo oscuro opcional de la web",
      "bg":       { "$value": "#0B0D11" },
      "surface":  { "$value": "#14171C" },
      "line":     { "$value": "#2A2E36" },
      "fg":       { "$value": "#EDEEF0" },
      "fg-2":     { "$value": "#A3A9B6" },
      "fg-3":     { "$value": "#8C93A0" },
      "code":     { "$value": "#C4F54A" },
      "context":  { "$value": "#8B7CFF" },
      "mcp":      { "$value": "#38D5E8" },
      "warning":  { "$value": "#F5B83D" },
      "danger":   { "$value": "#FF6B6B" }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Instrument Sans", "ui-sans-serif", "system-ui", "-apple-system", "Segoe UI", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"] }
    },
    "scale": {
      "$description": "size px / line-height / weight / wdth / tracking",
      "display": { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "64px", "lineHeight": 0.98, "fontWeight": 600, "fontStretch": "86%", "letterSpacing": "-0.035em" } },
      "h1":      { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "40px", "lineHeight": 1.02, "fontWeight": 600, "fontStretch": "88%", "letterSpacing": "-0.03em" } },
      "h2":      { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "30px", "lineHeight": 1.05, "fontWeight": 600, "fontStretch": "88%", "letterSpacing": "-0.03em" } },
      "h3":      { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "17px", "lineHeight": 1.3, "fontWeight": 600, "letterSpacing": "-0.01em" } },
      "body":    { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "15px", "lineHeight": 1.55, "fontWeight": 400 } },
      "small":   { "$value": { "fontFamily": "{font.family.sans}", "fontSize": "13px", "lineHeight": 1.5, "fontWeight": 400 } },
      "mono":    { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "12.5px", "lineHeight": 1.75, "fontWeight": 400 } },
      "label":   { "$value": { "fontFamily": "{font.family.mono}", "fontSize": "11px", "lineHeight": 1.4, "fontWeight": 500, "letterSpacing": "0.08em", "textTransform": "uppercase" } },
      "wordmark":{ "$value": { "fontFamily": "{font.family.mono}", "fontWeight": 800, "letterSpacing": "-0.05em" } }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" }, "2": { "$value": "8px" }, "3": { "$value": "12px" }, "4": { "$value": "16px" },
    "6": { "$value": "24px" }, "8": { "$value": "32px" }, "12": { "$value": "48px" }, "16": { "$value": "64px" }, "24": { "$value": "96px" }
  },
  "layout": {
    "$type": "dimension",
    "max-width": { "$value": "1200px" },
    "columns":   { "$type": "number", "$value": 12 },
    "gutter":    { "$value": "24px" },
    "gutter-sm": { "$value": "16px" },
    "header":    { "$value": "56px" }
  },
  "radius": {
    "$type": "dimension",
    "none":    { "$value": "0px", "$description": "Secciones" },
    "control": { "$value": "4px", "$description": "Botones, inputs, chips, comandos" },
    "iso":     { "$value": "22%", "$description": "Solo el isotipo" }
  },
  "border": {
    "$type": "border",
    "level-1": { "$value": { "color": "{color.line}", "width": "1px", "style": "solid" } },
    "level-2": { "$value": { "color": "{color.line-2}", "width": "1px", "style": "solid" } }
  },
  "shadow": {
    "$description": "Intencionalmente vacío: GenPM no usa sombras. La elevación es solo borde."
  },
  "motion": {
    "duration": { "$type": "duration", "fast": { "$value": "150ms" }, "base": { "$value": "200ms" }, "caret": { "$value": "1000ms" } },
    "easing":   { "$type": "cubicBezier", "out": { "$value": [0, 0, 0.2, 1] } }
  },
  "layer": {
    "$description": "Mapa de las tres C a tokens e iconos (web, CLI, badges)",
    "code":        { "$value": { "signal": "{color.code}",    "text": "{color.code-ink}", "dark": "{color.dark.code}",    "icon": "code-2" } },
    "context":     { "$value": { "signal": "{color.context}", "text": "{color.context}",  "dark": "{color.dark.context}", "icon": "file-text" } },
    "connections": { "$value": { "signal": "{color.mcp}",     "text": "{color.mcp}",      "dark": "{color.dark.mcp}",     "icon": "plug" } }
  }
}
