---
// /admin/analytics (ADR-027, solo staff): visitas, búsquedas, instalaciones y actividad del registry, contadas en el
// servidor sin cookies ni identificadores. Los mapas de calor y grabaciones (con consentimiento) viven en PostHog.
import { env } from 'cloudflare:workers';
import Account from '../../layouts/Account.astro';
import { requireSession, sessionExpired } from '../../lib/auth.js';
import { compact } from '../../lib/format.js';
import { href } from '../../lib/i18n.js';
import { registryFetch } from '../../lib/registry.js';

type KV = { k: string; n: number };
type Analytics = {
  days: number;
  since: string;
  configured: boolean;
  web: {
    daily: Array<{ day: string; event: string; who: string; n: number }>;
    referrers: KV[];
    pages: KV[];
    countries: KV[];
    campaigns: KV[];
    packages: KV[];
    searches: Array<KV & { results: number }>;
  } | null;
  installs: {
    daily: Array<{ day: string; client: string; n: number }>;
    packages: KV[];
    countries: KV[];
    cliVersions: KV[];
  } | null;
  registry: Array<{ day: string; action: string; n: number }>;
};

const gate = requireSession(Astro);
if (gate) return gate;
const { t, locale, session } = Astro.locals;
const RANGES = [1, 7, 30, 90];
const days = RANGES.includes(Number(Astro.url.searchParams.get('days')))
  ? Number(Astro.url.searchParams.get('days'))
  : 7;
const res = await registryFetch(`/v1/admin/analytics?days=${days}`, { token: session!.token, locale });
if (res.status === 401) return sessionExpired(Astro);
if (res.status === 404 || res.status === 403) {
  Astro.response.status = 404;
  return Astro.rewrite('/404');
}
const data = (res.ok ? await res.json() : null) as Analytics | null;
Astro.response.headers.set('Cache-Control', 'private, no-store');

const sum = <T extends { n: number }>(rows: T[], pick: (r: T) => boolean = () => true) =>
  rows.filter(pick).reduce((a, r) => a + r.n, 0);
const web = data?.web?.daily ?? [];
const inst = data?.installs?.daily ?? [];
const reg = data?.registry ?? [];
const kpis = {
  people: sum(web, (r) => r.event === 'page_view' && r.who === 'human'),
  members: sum(web, (r) => r.event === 'page_view' && r.who === 'member'),
  bots: sum(web, (r) => r.event === 'page_view' && r.who === 'bot'),
  pkgViews: sum(web, (r) => r.event === 'pkg_view' && r.who === 'human'),
  searches: sum(web, (r) => r.event === 'search' && r.who !== 'bot'),
  installs: sum(inst),
  viaMcp: sum(inst, (r) => r.client === 'mcp'),
  publishes: sum(reg, (r) => r.action === 'package.publish'),
  signups: sum(reg, (r) => r.action === 'account.create'),
  logins: sum(reg, (r) => r.action === 'auth.login'),
  spImpressions: sum(web, (r) => r.event === 'sponsored_impression' && r.who !== 'bot'),
  spClicks: sum(web, (r) => r.event === 'sponsored_click' && r.who !== 'bot'),
};
const rate = kpis.pkgViews ? Math.round((kpis.installs / kpis.pkgViews) * 1000) / 10 : 0;

// Una fila por día del rango, aunque no haya datos (los huecos también informan).
const start = Date.parse(`${data?.since ?? new Date().toISOString().slice(0, 10)}T00:00:00Z`);
const dayList = Array.from({ length: days }, (_, i) => new Date(start + i * 86_400_000).toISOString().slice(0, 10));
const rows = dayList.map((d) => ({
  day: d,
  people: sum(web, (r) => r.day === d && r.event === 'page_view' && r.who === 'human'),
  bots: sum(web, (r) => r.day === d && r.event === 'page_view' && r.who === 'bot'),
  installs: sum(inst, (r) => r.day === d),
  publishes: sum(reg, (r) => r.day === d && r.action === 'package.publish'),
}));
const peak = Math.max(1, ...rows.map((r) => Math.max(r.people, r.installs)));
const lists: Array<{ title: string; rows: KV[] }> =
  data?.web && data.installs
    ? [
        { title: t.t('web.admin.referrers'), rows: data.web.referrers },
        { title: t.t('web.admin.campaigns'), rows: data.web.campaigns },
        { title: t.t('web.admin.pages'), rows: data.web.pages },
        { title: t.t('web.admin.countries'), rows: data.web.countries },
        { title: t.t('web.admin.packages'), rows: data.web.packages },
        { title: t.t('web.admin.installsByPackage'), rows: data.installs.packages },
        { title: t.t('web.admin.installCountries'), rows: data.installs.countries },
        { title: t.t('web.admin.cliVersions'), rows: data.installs.cliVersions },
      ]
    : [];
const posthog = env.POSTHOG_KEY ? `${env.POSTHOG_UI_HOST ?? 'https://eu.posthog.com'}` : null;
---
<Account title={t.t('web.admin.title')} lede={t.t('web.admin.lede')} active="analytics" staff>
  <div class="row" slot="actions">
    <nav class="seg" aria-label={t.t('web.admin.range')}>
      {RANGES.map((d) => <a aria-current={d === days ? 'page' : undefined} href={`${href(locale, '/admin/analytics')}?days=${d}`}>{t.t('web.admin.days', { days: d })}</a>)}
    </nav>
    {posthog && <a class="btn sm" href={posthog} rel="noopener" target="_blank">{t.t('web.admin.heatmaps')}</a>}
  </div>
  <div class="adm">
    {!data && <div class="empty"><p>{t.t('web.admin.error')}</p></div>}
    {data && !data.configured && <div class="banner" style="--c:var(--warn)" role="status"><b>!</b><span>{t.t('web.admin.notConfigured')}</span></div>}
    {data && (
      <>
        <div class="kpis">
          <div><b class="tnum">{compact(locale, kpis.people)}</b><span class="k">{t.t('web.admin.kpiPeople')}</span></div>
          <div><b class="tnum">{compact(locale, kpis.pkgViews)}</b><span class="k">{t.t('web.admin.kpiPkgViews')}</span></div>
          <div><b class="tnum">{compact(locale, kpis.installs)}</b><span class="k">{t.t('web.admin.kpiInstalls', { mcp: kpis.viaMcp })}</span></div>
          <div><b class="tnum">{rate}%</b><span class="k">{t.t('web.admin.kpiRate')}</span></div>
          <div><b class="tnum">{compact(locale, kpis.searches)}</b><span class="k">{t.t('web.admin.kpiSearches')}</span></div>
          <div><b class="tnum">{compact(locale, kpis.signups)}</b><span class="k">{t.t('web.admin.kpiSignups', { logins: kpis.logins })}</span></div>
          <div><b class="tnum">{compact(locale, kpis.publishes)}</b><span class="k">{t.t('web.admin.kpiPublishes')}</span></div>
          <div><b class="tnum">{compact(locale, kpis.bots)}</b><span class="k">{t.t('web.admin.kpiBots', { members: kpis.members })}</span></div>
          <div><b class="tnum">{compact(locale, kpis.spClicks)}</b><span class="k">{t.t('web.admin.kpiSponsored', { views: kpis.spImpressions })}</span></div>
        </div>

        <section class="sec"><div class="sec-h"><h2>{t.t('web.admin.daily')}</h2></div>
          <div class="scroll"><table class="tbl"><thead><tr><th>{t.t('web.admin.colDay')}</th><th>{t.t('web.admin.colPeople')}</th><th>{t.t('web.admin.colInstalls')}</th><th class="num">{t.t('web.admin.colBots')}</th><th class="num">{t.t('web.admin.colPublishes')}</th></tr></thead><tbody>
            {rows.map((r) => (
              <tr>
                <td>{r.day}</td>
                <td><span class="meter"><span class="tnum">{r.people}</span><span class="bar" style={`--w:${(r.people / peak) * 100}%`}></span></span></td>
                <td><span class="meter"><span class="tnum">{r.installs}</span><span class="bar i" style={`--w:${(r.installs / peak) * 100}%`}></span></span></td>
                <td class="num">{r.bots}</td>
                <td class="num">{r.publishes}</td>
              </tr>
            ))}
          </tbody></table></div>
        </section>

        {lists.length > 0 && (
          <div class="grid">
            {lists.map((l) => (
              <section class="card"><h2>{l.title}</h2>
                {l.rows.length === 0 ? <p class="muted">{t.t('web.admin.empty')}</p> : (
                  <ol>{l.rows.map((r) => <li><span>{r.k}</span><b class="tnum">{r.n}</b></li>)}</ol>
                )}
              </section>
            ))}
            <section class="card wide"><h2>{t.t('web.admin.searches')}</h2>
              {data.web!.searches.length === 0 ? <p class="muted">{t.t('web.admin.empty')}</p> : (
                <ol>{data.web!.searches.map((s) => <li><span>{s.k}{s.results === 0 && <em class="zero">{t.t('web.admin.noResults')}</em>}</span><b class="tnum">{s.n}</b></li>)}</ol>
              )}
            </section>
          </div>
        )}
        <p class="muted foot">{t.t('web.admin.footnote')}</p>
      </>
    )}
  </div>
</Account>

<style>
  .adm { display: grid; gap: 24px; }
  .seg a { display: inline-flex; align-items: center; height: 28px; padding: 0 12px; font-family: var(--f-mono); font-size: 12px; color: var(--ink-2); border-radius: 2px; white-space: nowrap; }
  .seg a:hover { color: var(--ink); background: var(--wash); }
  .seg a[aria-current='page'] { background: var(--ink); color: var(--paper); }
  /* KPIs: separadores de 1 px; los de la última columna y fila se recortan con overflow (sin líneas dobles). */
  .kpis { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); border: 1px solid var(--line); border-radius: var(--r); overflow: hidden; }
  .kpis > div { padding: 18px; min-width: 0; display: grid; gap: 6px; align-content: start; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; }
  .kpis b { display: block; font-size: 28px; font-weight: 600; letter-spacing: -0.03em; line-height: 1.1; }
  .kpis .k { color: var(--ink-3); font-size: 11px; line-height: 1.5; }
  .meter { display: inline-grid; grid-template-columns: 4ch 120px; align-items: center; gap: 10px; }
  .meter .tnum { text-align: right; }
  .bar { display: block; height: 8px; width: var(--w); min-width: 1px; background: var(--ink); border-radius: 1px; }
  .bar.i { background: var(--mcp); }
  .grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .card { border: 1px solid var(--line); border-radius: var(--r); padding: 16px; min-width: 0; }
  .card.wide { grid-column: 1 / -1; }
  .card h2 { font-size: 15px; margin-bottom: 10px; }
  .card ol { list-style: none; padding: 0; margin: 0; }
  .card li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-top: 1px solid var(--line); font-size: 14px; color: var(--ink-2); }
  .card li b { color: var(--ink); font-weight: 600; }
  .card li span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .zero { color: var(--danger); font-style: normal; font-size: 12px; margin-left: 8px; }
  .muted { color: var(--ink-3); font-size: 14px; }
  .foot { font-size: 13px; }
  .adm .sec { padding-top: 8px; border-top: 0; }
  @media (max-width: 760px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid { grid-template-columns: 1fr; }
    .meter { grid-template-columns: 4ch 64px; }
  }
</style>
