---
// /settings/tokens (web-ui-spec §5.10): crear (se muestra una vez), listar por prefijo y revocar. Formularios POST
// (Astro verifica el Origin: protección CSRF).
import Account from '../../layouts/Account.astro';
import { requireSession, sessionExpired } from '../../lib/auth.js';
import { ago } from '../../lib/format.js';
import { registryFetch } from '../../lib/registry.js';

const gate = requireSession(Astro);
if (gate) return gate;
const { t, locale, session } = Astro.locals;
let created: { token: string; expiresAt: string } | null = null;
let error: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'revoke') {
    await registryFetch(`/v1/tokens/${String(form.get('id'))}`, { method: 'DELETE', token: session!.token });
  } else {
    const scopes = form.getAll('scopes').map(String);
    const res = await registryFetch('/v1/tokens', {
      method: 'POST',
      token: session!.token,
      body: {
        name: String(form.get('name') ?? '').slice(0, 64),
        scopes: scopes.length ? scopes : ['read'],
        days: Number(form.get('days') ?? 30),
      },
    });
    if (res.ok) created = (await res.json()) as { token: string; expiresAt: string };
    else error = ((await res.json().catch(() => ({}))) as { title?: string }).title ?? 'Error';
  }
}
const listRes = await registryFetch('/v1/tokens', { token: session!.token, locale });
// Incluye revocar desde aquí el propio token de la sesión web: la siguiente lectura ya no autentica.
if (listRes.status === 401) return sessionExpired(Astro);
const list = (listRes.ok ? await listRes.json() : { tokens: [] }) as {
  tokens: Array<{
    id: string;
    name: string;
    prefix: string;
    scopes: string[];
    expiresAt: string | null;
    lastUsedAt: string | null;
  }>;
};
Astro.response.headers.set('Cache-Control', 'private, no-store');
---
<Account title={t.t('web.tokens.title')} lede={t.t('web.tokens.lede')} active="tokens">
  {created && <div class="banner" style="--c:var(--code-ink)"><b>✔</b><span>{t.t('web.tokens.showOnce')}<div class="cmd sm" style="margin-top:8px"><code id="newtok">{created.token}</code><button class="cp" type="button" data-copy="newtok">{t.t('web.common.copy')}</button></div></span></div>}
  {error && <div class="banner" style="--c:var(--danger)"><b>!</b><span>{error}</span></div>}
  <section class="sec"><div class="sec-h"><h2>{t.t('web.tokens.listTitle')}</h2></div>
    {list.tokens.length === 0 ? <div class="empty sm"><p>{t.t('web.tokens.empty')}</p></div> : (
      <div class="scroll"><table class="tbl"><thead><tr><th>{t.t('web.tokens.name')}</th><th>{t.t('web.tokens.scopes')}</th><th>{t.t('web.tokens.lastUsed')}</th><th>{t.t('web.tokens.expires')}</th><th class="act"><span class="sr">{t.t('web.dashboard.actions')}</span></th></tr></thead><tbody>
        {list.tokens.map((k) => <tr><td>{k.name}<span class="sub mono">{k.prefix}…</span></td><td><span class="row" style="gap:4px">{k.scopes.map((s) => <span class="badge">{s}</span>)}</span></td><td>{k.lastUsedAt ? ago(locale, k.lastUsedAt) : t.t('web.tokens.never')}</td><td>{k.expiresAt ? ago(locale, k.expiresAt) : t.t('web.tokens.never')}</td><td class="act"><form method="post" data-confirm={t.t('web.tokens.revokeConfirm', { name: k.name })}><input type="hidden" name="action" value="revoke" /><input type="hidden" name="id" value={k.id} /><button class="btn sm ghost danger" type="submit">{t.t('web.tokens.revoke')}</button></form></td></tr>)}
      </tbody></table></div>
    )}
  </section>
  <section class="sec"><div class="sec-h"><h2>{t.t('web.tokens.newTitle')}</h2></div>
    <form method="post" class="builder" style="max-width:640px">
      <label class="field">{t.t('web.tokens.name')}<input name="name" required maxlength="64" placeholder="github-actions" /></label>
      <label class="field">{t.t('web.tokens.expiry')}<select name="days">{[30, 90, 365].map((d) => <option value={d}>{t.t('web.tokens.days', { count: d })}</option>)}</select></label>
      <fieldset class="field"><legend>{t.t('web.tokens.scopes')}</legend><div class="row" style="gap:20px"><label class="check"><input type="checkbox" name="scopes" value="read" checked /> read</label><label class="check"><input type="checkbox" name="scopes" value="publish" /> publish</label></div></fieldset>
      <button class="btn primary" type="submit">{t.t('web.tokens.create')}</button>
    </form>
  </section>
  <script>
    document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((f) => f.addEventListener('submit', (e) => { if (!confirm(f.dataset.confirm)) e.preventDefault(); }));
  </script>
</Account>
