---
// Home: título corto + instalación CLI|MCP y, justo debajo, el catálogo completo con filtro instantáneo; después
// cómo funciona, MCP por cliente, seguridad y publicar.
import ClientsBlock from '../components/ClientsBlock.astro';
import CommandBlock from '../components/CommandBlock.astro';
import Ico from '../components/Ico.astro';
import PackageCard from '../components/PackageCard.astro';
import Base from '../layouts/Base.astro';
import { filterText, groupPackages } from '../lib/catalog-groups.js';
import { compact } from '../lib/format.js';
import { href } from '../lib/i18n.js';
import { INSTALL_COMMANDS } from '../lib/installers.js';
import { registryGet, type SearchResponse, type Stats } from '../lib/registry.js';

const { t, locale } = Astro.locals;
// Portada = catálogo (decisión del fundador, 2026-10-20): todos los paquetes a la vista, agrupados por lo que resuelven.
const [all, stats] = await Promise.all([
  registryGet<SearchResponse>('/v1/search?limit=50&sort=installs', locale),
  registryGet<Stats>('/v1/stats', locale),
]);
const rows = all.data?.results ?? [];
const groups = groupPackages(rows);
const s = stats.data ?? { packages: 0, publishers: 0, installs30d: 0, installsTotal: 0, withMcp: 0 };
const total = Math.max(s.packages, rows.length);
// Cifras de la portada (auditoría 12-10): instalaciones y publicadores solo cuando aportan confianza; hasta entonces,
// datos igual de reales sobre el producto (clientes de IA de `genpm mcp setup` e idiomas de la web).
const tiles = [
  { n: compact(locale, total), k: t.t('web.home.statPackages') },
  s.installsTotal >= 1000
    ? { n: compact(locale, s.installsTotal), k: t.t('web.home.statInstalls') }
    : { n: compact(locale, 6), k: t.t('web.home.statClients') },
  s.publishers >= 10
    ? { n: compact(locale, s.publishers), k: t.t('web.home.statPublishers') }
    : { n: compact(locale, 8), k: t.t('web.home.statLanguages') },
];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, stale-while-revalidate=300');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://genpm.net/#website',
      name: 'GenPM',
      url: 'https://genpm.net',
      inLanguage: ['en', 'es', 'pt-BR', 'fr', 'de', 'ja', 'zh-CN', 'ko'],
      publisher: { '@id': 'https://genpm.net/#org' },
      potentialAction: {
        '@type': 'SearchAction',
        target: 'https://genpm.net/search?q={q}',
        'query-input': 'required name=q',
      },
    },
    {
      '@type': 'Organization',
      '@id': 'https://genpm.net/#org',
      name: 'GenPM',
      url: 'https://genpm.net',
      logo: 'https://genpm.net/apple-touch-icon.png',
      email: 'hello@genpm.net',
      sameAs: ['https://github.com/GenPM-net'],
      founder: {
        '@type': 'Person',
        name: 'Yohangel Ramos',
        url: 'https://yohangel.com',
        sameAs: ['https://github.com/Yohangel'],
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'genpm',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'macOS, Linux, Windows',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      downloadUrl: 'https://genpm.net/docs/install',
      publisher: { '@id': 'https://genpm.net/#org' },
    },
  ],
};
---
<Base stale={all.stale} packages={total} jsonLd={jsonLd}>
  <div class="wrap"><section class="hero hero-cat">
    <div style="min-width:0">
      <span class="eyebrow"><i></i>{t.t('web.home.eyebrow')}</span>
      <h1 class="h1">{t.t('web.home.heroTitle')}</h1>
      <p class="lede">{t.t('web.home.heroLede')}</p>
      <div class="trust"><span><Ico name="commit" />{t.t('web.home.trustSha')}</span><span><Ico name="ban" />{t.t('web.home.trustScripts')}</span><span><Ico name="shield" />{t.t('web.home.trustScan')}</span></div>
    </div>
    <div class="cta" data-tabs style="margin-top:0">
      <div class="top2"><div class="seg" role="tablist" aria-label={t.t('web.home.installMethod')}><button role="tab" type="button" aria-selected="true" data-tab="cli">CLI</button><button role="tab" type="button" aria-selected="false" tabindex="-1" data-tab="mcp">MCP</button></div><span class="hint">{t.t('web.home.noNode')}</span></div>
      <div data-panel="cli" data-os-box style="display:grid;gap:10px">
        <div class="runner" role="group" aria-label={t.t('web.home.os')}><button type="button" aria-pressed="true" data-os="unix">macOS · Linux</button><button type="button" aria-pressed="false" data-os="windows">Windows</button></div>
        <div data-os-panel="unix"><CommandBlock command={INSTALL_COMMANDS.unix} event="install_cli_copy" /></div>
        <div data-os-panel="windows" hidden><CommandBlock command={INSTALL_COMMANDS.windows} event="install_cli_copy" /></div>
        <CommandBlock command="genpm add @core/auth" pkg="@core/auth" />
        <a class="hint" href={href(locale, '/docs/install')}>{t.t('web.home.installMore')}</a>
      </div>
      <div data-panel="mcp" hidden><CommandBlock command="genpm mcp setup" event="mcp_setup_copy" /><p class="hint" style="margin-top:10px">{t.t('web.home.thenAsk')} <code>{t.t('web.home.askExample')}</code></p></div>
    </div>
  </section></div>

  <section class="wrap catalog" id="packages" aria-labelledby="catalog-title">
    <div class="cat-top">
      <h2 id="catalog-title">{t.t('web.home.catalogTitle', { count: total })}</h2>
      <label class="hsearch cat-q"><Ico name="search" /><input type="search" data-catq placeholder={t.t('web.home.filterPlaceholder')} aria-label={t.t('web.home.filterLabel')} autocomplete="off" /></label>
    </div>
    <nav class="cat-nav" aria-label={t.t('web.home.categoriesLabel')}>
      {groups.map((g) => <a href={`#${g.id}`} data-catlink={g.id}>{t.raw(`web.home.cat.${g.id}`)} <span class="tnum">{g.items.length}</span></a>)}
    </nav>
    {groups.map((g) => (
      <div class="cat-g" id={g.id} data-catgroup>
        <div class="cat-h"><h3>{t.raw(`web.home.cat.${g.id}`)}</h3><p>{t.raw(`web.home.catText.${g.id}`)}</p></div>
        <div class="cards cards3">{g.items.map((p) => <PackageCard p={p} filter={filterText(p)} installs={false} />)}</div>
      </div>
    ))}
    <div class="cat-empty" data-catempty hidden><p>{t.t('web.home.filterEmpty')}</p><a class="btn sm" data-catsearch href={href(locale, '/search')}>{t.t('web.home.searchRegistry')} <Ico name="arrow" style="width:14px;height:14px" /></a></div>
  </section>

  <section class="wrap sec"><div class="sec-h"><div><div class="k">{t.t('web.home.howKicker')}</div><h2>{t.t('web.home.howTitle')}</h2></div><a class="btn sm" href={href(locale, '/docs/how-it-works')}>{t.t('web.common.readDocs')} <Ico name="arrow" style="width:14px;height:14px" /></a></div>
    <div class="cols3">
      <div><span class="no">1</span><h3>{t.t('web.home.step1')}</h3><p>{t.t('web.home.step1Text')}</p><code class="chip">genpm search stripe</code></div>
      <div><span class="no">2</span><h3>{t.t('web.home.step2')}</h3><p>{t.t('web.home.step2Text')}</p><code class="chip">genpm info @core/billing</code></div>
      <div><span class="no">3</span><h3>{t.t('web.home.step3')}</h3><p>{t.t('web.home.step3Text')}</p><code class="chip">genpm add @core/billing</code></div>
    </div>
  </section>

  <section class="wrap sec"><div class="sec-h"><div><div class="k">{t.t('web.home.aiKicker')}</div><h2>{t.t('web.home.aiTitle')}</h2><p>{t.t('web.home.aiText')}</p></div><a class="btn sm" href={href(locale, '/mcp')}>{t.t('web.home.allClients')} <Ico name="arrow" style="width:14px;height:14px" /></a></div><ClientsBlock /></section>

  <section class="wrap sec"><div class="sec-h"><div><div class="k">{t.t('web.home.secKicker')}</div><h2>{t.t('web.home.secTitle')}</h2></div></div>
    <div class="cols3">
      <div><h3><Ico name="commit" style="color:var(--context)" />{t.t('web.home.secSha')}</h3><p>{t.t('web.home.secShaText')}</p></div>
      <div><h3><Ico name="ban" />{t.t('web.home.secScripts')}</h3><p>{t.t('web.home.secScriptsText')}</p></div>
      <div><h3><Ico name="shield" style="color:var(--code-ink)" />{t.t('web.home.secScan')}</h3><p>{t.t('web.home.secScanText')}</p></div>
    </div>
  </section>

  <section class="wrap sec"><div class="pub">
    <div><div class="k">{t.t('web.home.pubKicker')}</div><h2 style="margin-top:10px">{t.t('web.home.pubTitle')}</h2><p>{t.t('web.home.pubText')}</p><div class="row" style="margin-top:28px"><a class="btn primary lg" href={href(locale, '/publish')}>{t.t('web.home.pubCta')}</a><a class="btn ghost lg" href={href(locale, '/docs')}>{t.t('web.common.readDocs')}</a></div></div>
    <div class="stats">{tiles.map((x) => <div><b class="tnum">{x.n}</b><span class="k">{x.k}</span></div>)}</div>
  </div></section>

  <script>
    // Filtro instantáneo del catálogo: oculta tarjetas y grupos que no coinciden, sin recargar. Sin JS se ve todo.
    const q = document.querySelector<HTMLInputElement>('[data-catq]');
    const empty = document.querySelector<HTMLElement>('[data-catempty]');
    const more = document.querySelector<HTMLAnchorElement>('[data-catsearch]');
    const base = more?.getAttribute('href') ?? '/search';
    q?.addEventListener('input', () => {
      const words = q.value.toLowerCase().trim().split(/\s+/).filter(Boolean);
      let shown = 0;
      for (const g of document.querySelectorAll<HTMLElement>('[data-catgroup]')) {
        let n = 0;
        for (const c of g.querySelectorAll<HTMLElement>('[data-filter]')) {
          const ok = words.every((w) => (c.dataset.filter ?? '').includes(w));
          c.hidden = !ok;
          if (ok) n++;
        }
        g.hidden = n === 0;
        document.querySelector<HTMLElement>(`[data-catlink="${g.id}"]`)?.toggleAttribute('hidden', n === 0);
        shown += n;
      }
      if (empty) empty.hidden = shown > 0;
      if (more) more.href = words.length ? `${base}?q=${encodeURIComponent(q.value.trim())}` : base;
    });
  </script>
</Base>
