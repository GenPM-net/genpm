---
// /mcp (web-ui-spec §5.6): selector de cliente, bloques copiables, deeplinks, herramientas y garantías.
import ClientsBlock from '../components/ClientsBlock.astro';
import Ico from '../components/Ico.astro';
import Base from '../layouts/Base.astro';

const { t } = Astro.locals;
const tools = ['search', 'info', 'add', 'list', 'remove', 'outdated', 'audit', 'validate'] as const;
Astro.response.headers.set('Cache-Control', 'public, max-age=3600');
---
<Base title={t.t('web.nav.mcp')} description={t.t('web.mcp.lede')} nav="mcp">
  <div class="wrap">
    <div class="phead"><span class="eyebrow" style="--c:var(--mcp);justify-self:start"><i></i>{t.t('web.mcp.eyebrow')}</span><h1>{t.t('web.mcp.title')}</h1><p>{t.t('web.mcp.lede')}</p></div>
    <section class="sec" style="padding-top:40px"><div class="sec-h"><div><div class="k">{t.t('web.mcp.step1')}</div><h2>{t.t('web.mcp.step1Title')}</h2></div></div><ClientsBlock /></section>
    <section class="sec"><div class="sec-h"><div><div class="k">{t.t('web.mcp.step2')}</div><h2>{t.t('web.mcp.step2Title')}</h2><p>{t.t('web.mcp.step2Text')}</p></div></div>
      <div class="scroll"><table class="tbl"><thead><tr><th>{t.t('web.mcp.tool')}</th><th>{t.t('web.mcp.does')}</th></tr></thead><tbody>
        {tools.map((x) => <tr><td style="color:var(--mcp)">genpm_{x}</td><td class="txt">{t.raw(`web.mcp.t_${x}`)}</td></tr>)}
      </tbody></table></div>
    </section>
    <section class="sec"><div class="sec-h"><div><div class="k">{t.t('web.mcp.safety')}</div><h2>{t.t('web.mcp.safetyTitle')}</h2></div></div>
      <div class="cols3">
        <div><h3><Ico name="plug" style="color:var(--mcp)" />{t.t('web.mcp.s1')}</h3><p>{t.t('web.mcp.s1Text')}</p></div>
        <div><h3><Ico name="code" style="color:var(--code-ink)" />{t.t('web.mcp.s2')}</h3><p>{t.t('web.mcp.s2Text')}</p></div>
        <div><h3><Ico name="ban" />{t.t('web.mcp.s3')}</h3><p>{t.t('web.mcp.s3Text')}</p></div>
      </div>
    </section>
  </div>
</Base>
