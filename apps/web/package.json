{
  "name": "@genpm/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-fonts.mjs && astro dev",
    "build": "node scripts/copy-fonts.mjs && node ../../scripts/brand/gen-tokens.mjs && astro build",
    "preview": "astro preview",
    "build:deps": "turbo run build --filter=@genpm/web^...",
    "deploy:staging": "pnpm build:deps && CLOUDFLARE_ENV=staging pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "deploy": "node ../../scripts/check-legal.mjs && pnpm build:deps && pnpm build && wrangler deploy --config dist/server/wrangler.json",
    "typecheck": "astro check",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.0",
    "@astrojs/preact": "^6.0.0",
    "@genpm/i18n": "workspace:*",
    "@genpm/manifest": "workspace:*",
    "astro": "^7.3.0",
    "marked": "^18.0.0",
    "posthog-js": "^1.436.1",
    "preact": "^10.27.0",
    "shiki": "^4.5.0",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^4.20260101.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-jp": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@genpm/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.3.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.3",
    "wrangler": "^4.125.0"
  }
}
