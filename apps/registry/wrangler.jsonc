// genpm-registry · Cloudflare Worker (Hono) + D1 (api-spec §9). Solo metadatos: nunca aloja archivos de paquetes.
// Secretos (wrangler secret put … [--env staging]): TOKEN_PEPPER, IP_SALT, SIGNING_KEYS, GITHUB_APP_ID,
// GITHUB_APP_PRIVATE_KEY, GITHUB_OAUTH_CLIENT_ID, GITHUB_OAUTH_CLIENT_SECRET y CF_AE_TOKEN (token de
// Cloudflare con "Account Analytics: Read", para los contadores de instalaciones). Nunca en este archivo (security §5).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "genpm-registry",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "vars": {
    "ENVIRONMENT": "production",
    "WEB_ORIGIN": "https://genpm.net",
    "SIGNING_KEY_ID": "k1",
    "INDEXNOW_KEY": "6a937e8e5b77ea0d8153becc5e82d58f",
    "CF_ACCOUNT_ID": "f88afb06c6eea1879507e01c7d16e56d"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "genpm-registry",
      "database_id": "fd31f31d-abc6-4784-921a-931e61e7f2ca",
      "migrations_dir": "migrations"
    }
  ],
  "analytics_engine_datasets": [{ "binding": "INSTALLS", "dataset": "genpm_installs" }],
  // Tenancy dedicada (ENT-01, runbook §3.4): descomentar tras `wrangler dispatch-namespace create genpm-tenants`
  // (requiere Workers for Platforms). Sin el binding, un registro dedicado responde 500 (falla cerrado).
  // "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "genpm-tenants" }],
  // Verified Archive (V03-02): activar R2 en el panel de Cloudflare, `wrangler r2 bucket create genpm-archive`
  // (y -staging) y descomentar. Sin el binding, publicar e instalar funcionan igual; solo no se guarda la copia.
  // "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "genpm-archive" }],
  // Cola del escaneo profundo de publish (security §3.1): el Worker de la API produce y él mismo consume.
  "queues": {
    "producers": [{ "binding": "SCAN_QUEUE", "queue": "genpm-scan" }],
    "consumers": [{ "queue": "genpm-scan", "max_batch_size": 5, "max_retries": 3 }]
  },
  "ratelimits": [
    { "name": "RL_PUBLIC", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "RL_AUTH", "namespace_id": "1002", "simple": { "limit": 1200, "period": 60 } },
    { "name": "RL_PUBLISH", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
    { "name": "RL_EXCHANGE", "namespace_id": "1004", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["0 * * * *", "15 3 * * *", "0 4 * * SUN"] },
  "routes": [
    { "pattern": "api.genpm.net", "custom_domain": true },
    { "pattern": "mcp.genpm.net", "custom_domain": true },
    { "pattern": "domains.genpm.net", "custom_domain": true }
  ],
  "env": {
    "staging": {
      "name": "genpm-registry-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "WEB_ORIGIN": "https://staging.genpm.net",
        "SIGNING_KEY_ID": "s3",
        // Vacía a propósito: staging no avisa a los buscadores (IndexNow desactivado).
        "INDEXNOW_KEY": "",
        "CF_ACCOUNT_ID": "f88afb06c6eea1879507e01c7d16e56d"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "genpm-registry-staging",
          "database_id": "b715994c-6127-4e91-ae5b-ef49c9ba6234",
          "migrations_dir": "migrations"
        }
      ],
      "analytics_engine_datasets": [{ "binding": "INSTALLS", "dataset": "genpm_installs_staging" }],
      // "r2_buckets": [{ "binding": "ARCHIVE", "bucket_name": "genpm-archive-staging" }],
      "queues": {
        "producers": [{ "binding": "SCAN_QUEUE", "queue": "genpm-scan-staging" }],
        "consumers": [{ "queue": "genpm-scan-staging", "max_batch_size": 5, "max_retries": 3 }]
      },
      "ratelimits": [
        { "name": "RL_PUBLIC", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "RL_AUTH", "namespace_id": "2002", "simple": { "limit": 1200, "period": 60 } },
        { "name": "RL_PUBLISH", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
        { "name": "RL_EXCHANGE", "namespace_id": "2004", "simple": { "limit": 10, "period": 60 } }
      ],
      "triggers": { "crons": ["0 * * * *", "15 3 * * *", "0 4 * * SUN"] },
      "routes": [
        { "pattern": "api.staging.genpm.net", "custom_domain": true },
        { "pattern": "mcp.staging.genpm.net", "custom_domain": true }
      ]
    }
  }
}
